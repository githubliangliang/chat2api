# =============================================================================
# sub2api_new SQLite 模式环境变量示例
# 复制为 .env.sqlite 后按需修改：
#   cp .env.sqlite.example .env.sqlite
# =============================================================================

# 监听
BIND_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

# 管理员（首次启动自动创建）
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=admin123456

# 固定密钥，避免容器重建后全部掉线
# 生成：openssl rand -hex 32
JWT_SECRET=please-change-me-use-openssl-rand-hex-32
# TOTP 可选；启用 2FA 时建议固定：openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# 构建代理（可选）
# GOPROXY=https://goproxy.cn,direct
# GOSUMDB=sum.golang.google.cn
