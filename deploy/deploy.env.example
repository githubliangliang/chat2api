# =============================================================================
# 远程部署配置（被 deploy/deploy-remote.sh 读取）
# 用法：cp deploy/deploy.env.example deploy/deploy.env && 改成你的 VPS 信息
# 注意：deploy.env 命中根 .gitignore 的 *.env，不会被提交；建议 chmod 600
# =============================================================================

# ---------- 服务器 ----------
REMOTE_HOST="1.2.3.4"
REMOTE_USER="root"
REMOTE_PORT="22"

# 免密方式 A（推荐）：SSH 私钥。留空则用 ssh-agent / SSH 默认 key
# 还没配过就先跑一次：deploy/deploy-remote.sh --setup-key
SSH_KEY="$HOME/.ssh/id_ed25519"

# 免密方式 B（不推荐）：明文密码，需要本机装 sshpass。留空即不启用
SSH_PASSWORD=""

# 首次连接自动记住主机指纹；想强制严格校验改成 yes
SSH_STRICT="accept-new"

# ---------- 远端布局（对应 deploy/sub2api-sqlite.service）----------
REMOTE_DIR="/opt/sub2api"      # 二进制 + data/（config.yaml、sqlite）所在目录
SERVICE_NAME="sub2api"         # systemd 服务名
SERVICE_USER="sub2api"         # 运行用户；填 root 表示直接用 root 跑
APP_PORT="8080"                # 健康检查端口 + systemd 里的 SERVER_PORT

# 重启方式：systemd（默认）| command（自定义，如 docker）| none（只换二进制不重启）
RESTART_MODE="systemd"
# RESTART_MODE="command" 时执行的远端命令，例如：
# RESTART_COMMAND="cd /opt/sub2api && docker compose restart"
RESTART_COMMAND=""

# ---------- 构建 / 校验 ----------
TARGET_ARCH="amd64"            # amd64 | arm64，按 VPS 的 CPU 选
HEALTH_TIMEOUT="60"            # /health 等待秒数，超时自动回滚到上一版本
KEEP_RELEASES="3"              # 远端 releases/ 保留的历史版本数

# ---------- 仅首次部署有用（远端还没有 data/config.yaml 时）----------
# 已存在的 config.yaml 永远不会被覆盖，除非显式加 --force-config
ADMIN_EMAIL="admin@example.com"
# 留空则自动生成随机密码并在部署日志里打印一次
ADMIN_PASSWORD=""
